# Terraform/OpenTofu state — never commit
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
!hetzner/.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local secrets & env — never commit
.envrc
*.env
# The nixos/secrets/timestone/*.age files ARE committed — they are age
# CIPHERTEXT (useless without the office/nodes keys) and must be present in the
# fetched public flake for the nodes' remote auto-update to evaluate. Never
# commit plaintext secret material (see nixos/secrets/README.md).
.nixos-anywhere-extra/
age-identity
age.key
*.pem
*.key

# In-repo tool binaries and operator runtime (never commit)
.tools/
.runtime/
